# Handle text files automatically and enforce LF line endings on checkout/commit
* text=auto eol=lf

# Explicitly declare files that must always maintain LF (e.g., shell scripts)
*.sh text eol=lf
*.bash text eol=lf

# Standard web and configuration files
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf

# Dev Container configuration files
.devcontainer/devcontainer.json text eol=lf
Dockerfile text eol=lf

# Denote binary files (Git will leave these completely untouched)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff text eol=lf
*.woff2 text eol=lf
